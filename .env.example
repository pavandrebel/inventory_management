# Application
APP_NAME=Inventory Management
APP_COMPANY=Your Company Name
APP_PRIMARY_COLOR=#2563eb
APP_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata

# Database
POSTGRES_USER=inventory
